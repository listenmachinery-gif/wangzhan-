generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductSectionType {
  HERO
  OVERVIEW
  PRODUCT_SHOWCASE
  DETAIL_GALLERY
  OPTION_CAROUSEL
  MATERIAL_GALLERY
  PROBLEMS
  SOLUTION
  PROCESS
  APPLICATIONS
  MATERIAL_GUIDANCE
  ADVANTAGES
  STRUCTURE
  TECHNICAL
  MODEL_CARDS
  INDUSTRY_GALLERY
  MODEL_GUIDE
  COMPARISON
  ENERGY_COMPARISON
  WORKFLOW
  MANUFACTURER_SUPPORT
  FAQ
  RELATED_LINKS
  CTA
}

enum MediaLifecycleStatus {
  ACTIVE
  TOMBSTONED
  DELETED
}

enum ShippingMediaRole {
  COVER
  LOADING
  EQUIPMENT
  VIDEO
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_DISCUSSION
  QUOTED
  WON
  LOST
  SPAM
}

enum CrmRecordOrigin {
  WEBSITE_FORM
  MANUAL
  INTEGRATION
}

enum CrmSourceChannel {
  WEBSITE
  EMAIL
  WHATSAPP
  PHONE
  FACEBOOK
  LINKEDIN
  TRADE_SHOW
  REFERRAL
  OTHER
}

enum CustomerLevel {
  A
  B
  C
  D
}

enum CrmTeamMembershipRole {
  MEMBER
  MANAGER
  VIEWER
}

enum CrmStageTransitionSource {
  SYSTEM
  LEGACY_API
  CRM_API
  BACKFILL
}

enum LeadActivityType {
  NOTE
  STATUS_CHANGE
  ASSIGNMENT
  EMAIL
  FOLLOW_UP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum AnalyticsEnvironment {
  DEVELOPMENT
  TEST
  PREVIEW
  PRODUCTION
}

enum AnalyticsEventType {
  PRODUCT_VIEW
  INQUIRY_START
  INQUIRY_SUBMIT
  WHATSAPP_CLICK
  EMAIL_CLICK
  CATALOG_DOWNLOAD
  CHAT_STARTED
  CHAT_MESSAGE_SENT
}

enum ChatConversationStatus {
  OPEN
  PENDING
  CLOSED
  SPAM
}

enum ChatSenderType {
  VISITOR
  AGENT
  SYSTEM
}

enum ChatMessageType {
  TEXT
  SYSTEM
}

model User {
  id                         String                     @id @default(cuid())
  email                      String                     @unique
  name                       String
  passwordHash               String
  isActive                   Boolean                    @default(true)
  twoFactorEnabled           Boolean                    @default(false)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  roles                      UserRole[]
  sessions                   Session[]
  loginAttempts              LoginAttempt[]
  auditLogs                  AuditLog[]                 @relation("AuditActor")
  uploadedMedia              MediaAsset[]               @relation("MediaUploader")
  leadActivities             LeadActivity[]             @relation("LeadActivityActor")
  assignedLeads              LeadAssignment[]           @relation("LeadAssignee")
  leadAssignmentsMade        LeadAssignment[]           @relation("LeadAssignedBy")
  authoredPageVersions       PageVersion[]              @relation("PageVersionAuthor")
  authoredNavigationVersions NavigationVersion[]        @relation("NavigationVersionAuthor")
  authoredShippingVersions   ShippingHighlightVersion[] @relation("ShippingHighlightVersionAuthor")
  sentChatMessages           ChatMessage[]              @relation("ChatMessageSender")
  chatAssignments            ChatAssignment[]           @relation("ChatAssignee")
  chatAssignmentsMade        ChatAssignment[]           @relation("ChatAssignedBy")
  ownedCompanies             Company[]                  @relation("CompanyOwner")
  createdCompanies           Company[]                  @relation("CompanyCreator")
  updatedCompanies           Company[]                  @relation("CompanyUpdater")
  ownedContacts              Contact[]                  @relation("ContactOwner")
  createdContacts            Contact[]                  @relation("ContactCreator")
  updatedContacts            Contact[]                  @relation("ContactUpdater")
  createdLeads               Lead[]                     @relation("LeadCreator")
  updatedLeads               Lead[]                     @relation("LeadUpdater")
  leadStageChanges           LeadStageHistory[]         @relation("LeadStageHistoryActor")
  createdCrmTeams            CrmTeam[]                  @relation("CrmTeamCreator")
  updatedCrmTeams            CrmTeam[]                  @relation("CrmTeamUpdater")
  crmMemberships             CrmTeamMembership[]        @relation("CrmTeamMember")
  createdMemberships         CrmTeamMembership[]        @relation("CrmTeamMembershipCreator")
  updatedMemberships         CrmTeamMembership[]        @relation("CrmTeamMembershipUpdater")
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipHash    String?
  userAgent String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model LoginAttempt {
  id             String   @id @default(cuid())
  userId         String?
  accountKeyHash String
  networkKeyHash String
  succeeded      Boolean  @default(false)
  attemptedAt    DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([accountKeyHash, attemptedAt])
  @@index([networkKeyHash, attemptedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  requestId  String?
  ipHash     String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model ProductCategory {
  id                     String                  @id @default(cuid())
  parentId               String?
  name                   String
  slug                   String                  @unique
  summary                String?
  description            String?
  status                 PublicationStatus       @default(DRAFT)
  position               Int                     @default(0)
  version                Int                     @default(1)
  publishedAt            DateTime?
  archivedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  parent                 ProductCategory?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children               ProductCategory[]       @relation("CategoryTree")
  products               Product[]
  specificationTemplates SpecificationTemplate[]
  shippingHighlights     ShippingHighlight[]     @relation("ShippingHighlightCategory")

  @@index([parentId, position])
  @@index([status, position])
}

model Product {
  id                 String              @id @default(cuid())
  categoryId         String
  name               String
  slug               String              @unique
  summary            String
  description        String?
  status             PublicationStatus   @default(DRAFT)
  position           Int                 @default(0)
  version            Int                 @default(1)
  slugLocked         Boolean             @default(true)
  registeredWidget   String?
  publishedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  category           ProductCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sections           ProductSection[]
  models             ProductModel[]
  leads              Lead[]
  seoRecords         SeoRecord[]
  analyticsPageViews AnalyticsPageView[]
  analyticsEvents    AnalyticsEvent[]
  shippingHighlights ShippingHighlight[] @relation("ShippingHighlightProduct")

  @@index([categoryId, status, position])
  @@index([status, publishedAt])
}

model ProductSection {
  id        String             @id @default(cuid())
  productId String
  type      ProductSectionType
  position  Int
  visible   Boolean            @default(true)
  content   Json
  version   Int                @default(1)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, type])
  @@unique([productId, position])
}

model ProductModel {
  id        String               @id @default(cuid())
  productId String
  name      String
  sku       String?
  position  Int                  @default(0)
  active    Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    SpecificationValue[]

  @@unique([productId, name])
  @@unique([productId, position])
}

model SpecificationTemplate {
  id         String               @id @default(cuid())
  categoryId String?
  name       String
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  category   ProductCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  fields     SpecificationField[]

  @@unique([categoryId, name])
}

model SpecificationField {
  id         String                @id @default(cuid())
  templateId String
  name       String
  unit       String?
  valueType  String                @default("TEXT")
  position   Int
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  template   SpecificationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  values     SpecificationValue[]

  @@unique([templateId, name])
  @@unique([templateId, position])
}

model SpecificationValue {
  id        String             @id @default(cuid())
  modelId   String
  fieldId   String
  value     String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  model     ProductModel       @relation(fields: [modelId], references: [id], onDelete: Cascade)
  field     SpecificationField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([modelId, fieldId])
}

model MediaAsset {
  id              String               @id @default(cuid())
  objectKey       String               @unique
  originalName    String
  mimeType        String
  byteSize        Int
  checksum        String               @unique
  usage           String
  altText         String?
  category        String?
  width           Int?
  height          Int?
  lifecycleStatus MediaLifecycleStatus @default(ACTIVE)
  uploadedById    String
  replacedById    String?              @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  uploadedBy      User                 @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  replacedBy      MediaAsset?          @relation("MediaReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces        MediaAsset?          @relation("MediaReplacement")
  references      MediaReference[]
  desktopBanners  Banner[]             @relation("BannerDesktopMedia")
  tabletBanners   Banner[]             @relation("BannerTabletMedia")
  mobileBanners   Banner[]             @relation("BannerMobileMedia")
  ogSeoRecords    SeoRecord[]          @relation("SeoOgMedia")
  shippingCovers  ShippingHighlight[]  @relation("ShippingHighlightCover")
  shippingMedia   ShippingMedia[]

  @@index([lifecycleStatus, createdAt])
}

model MediaReference {
  id           String     @id @default(cuid())
  mediaAssetId String
  entityType   String
  entityId     String
  field        String
  createdAt    DateTime   @default(now())
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([mediaAssetId, entityType, entityId, field])
  @@index([entityType, entityId])
}

model Banner {
  id             String            @id @default(cuid())
  name           String
  title          String
  subtitle       String?
  buttonText     String?
  buttonUrl      String?
  textColor      String?
  textPosition   String?
  maskOpacity    Int?
  desktopMediaId String
  tabletMediaId  String?
  mobileMediaId  String?
  status         PublicationStatus @default(DRAFT)
  enabled        Boolean           @default(true)
  position       Int               @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  version        Int               @default(1)
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  desktopMedia   MediaAsset        @relation("BannerDesktopMedia", fields: [desktopMediaId], references: [id], onDelete: Restrict)
  tabletMedia    MediaAsset?       @relation("BannerTabletMedia", fields: [tabletMediaId], references: [id], onDelete: Restrict)
  mobileMedia    MediaAsset?       @relation("BannerMobileMedia", fields: [mobileMediaId], references: [id], onDelete: Restrict)

  @@index([status, enabled, startsAt, endsAt, position])
}

model NavigationDocument {
  id               String              @id @default(cuid())
  key              String              @unique
  status           PublicationStatus   @default(DRAFT)
  draftContent     Json
  publishedContent Json?
  version          Int                 @default(1)
  publishedVersion Int?
  publishedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  versions         NavigationVersion[]

  @@index([status, updatedAt])
}

model NavigationVersion {
  id                   String             @id @default(cuid())
  navigationDocumentId String
  version              Int
  snapshot             Json
  action               String
  createdById          String
  createdAt            DateTime           @default(now())
  publishedAt          DateTime?
  navigationDocument   NavigationDocument @relation(fields: [navigationDocumentId], references: [id], onDelete: Cascade)
  createdBy            User               @relation("NavigationVersionAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([navigationDocumentId, version])
  @@index([navigationDocumentId, createdAt])
  @@index([createdById, createdAt])
}

model ShippingHighlight {
  id                    String                     @id @default(cuid())
  slug                  String                     @unique
  slugLocked            Boolean                    @default(false)
  status                PublicationStatus          @default(DRAFT)
  version               Int                        @default(1)
  draftContent          Json
  publishedContent      Json?
  publishedVersion      Int?
  publishedAt           DateTime?
  publishedShipmentDate DateTime?
  publishedCountryCode  String?
  publishedCategorySlug String?
  categoryId            String?
  productId             String?
  coverMediaId          String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  category              ProductCategory?           @relation("ShippingHighlightCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  product               Product?                   @relation("ShippingHighlightProduct", fields: [productId], references: [id], onDelete: SetNull)
  coverMedia            MediaAsset?                @relation("ShippingHighlightCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  media                 ShippingMedia[]
  versions              ShippingHighlightVersion[]

  @@index([status, publishedShipmentDate])
  @@index([publishedCountryCode, publishedShipmentDate])
  @@index([publishedCategorySlug, publishedShipmentDate])
  @@index([categoryId])
  @@index([productId])
  @@index([coverMediaId])
}

model ShippingHighlightVersion {
  id                  String            @id @default(cuid())
  shippingHighlightId String
  version             Int
  snapshot            Json
  action              String
  createdById         String
  createdAt           DateTime          @default(now())
  publishedAt         DateTime?
  shippingHighlight   ShippingHighlight @relation(fields: [shippingHighlightId], references: [id], onDelete: Cascade)
  createdBy           User              @relation("ShippingHighlightVersionAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([shippingHighlightId, version])
  @@index([shippingHighlightId, createdAt])
  @@index([createdById, createdAt])
}

model ShippingMedia {
  id                  String            @id @default(cuid())
  shippingHighlightId String
  mediaAssetId        String
  role                ShippingMediaRole
  position            Int
  caption             String?
  altText             String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  shippingHighlight   ShippingHighlight @relation(fields: [shippingHighlightId], references: [id], onDelete: Cascade)
  mediaAsset          MediaAsset        @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([shippingHighlightId, role, position])
  @@index([shippingHighlightId, position])
  @@index([mediaAssetId])
}

model Company {
  id             String    @id @default(cuid())
  companyCode    String    @unique
  name           String
  normalizedName String
  website        String?
  industry       String?
  companySize    String?
  countryCode    String?
  state          String?
  city           String?
  postalCode     String?
  address        String?
  ownerId        String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  version        Int       @default(1)
  owner          User?     @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy      User?     @relation("CompanyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?     @relation("CompanyUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  contacts       Contact[]
  leads          Lead[]

  @@index([normalizedName, countryCode])
  @@index([ownerId])
  @@index([createdById])
  @@index([updatedById])
}

model Contact {
  id                     String         @id @default(cuid())
  customerCode           String         @unique
  companyId              String?
  fullName               String
  firstName              String?
  lastName               String?
  jobTitle               String?
  department             String?
  email                  String?
  normalizedEmail        String?
  phone                  String?
  phoneE164              String?
  whatsapp               String?
  whatsappE164           String?
  countryCode            String?
  state                  String?
  city                   String?
  timezone               String?
  preferredLanguage      String?
  preferredContactMethod String?
  preferredContactTime   String?
  customerLevel          CustomerLevel?
  customerStatus         String?
  ownerId                String?
  internalNotes          String?
  firstInquiryAt         DateTime?
  lastInquiryAt          DateTime?
  lastFollowUpAt         DateTime?
  nextFollowUpAt         DateTime?
  createdById            String?
  updatedById            String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  version                Int            @default(1)
  company                Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner                  User?          @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy              User?          @relation("ContactCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy              User?          @relation("ContactUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  leads                  Lead[]

  @@index([companyId])
  @@index([ownerId])
  @@index([createdById])
  @@index([updatedById])
  @@index([normalizedEmail])
  @@index([phoneE164])
  @@index([whatsappE164])
}

model CrmStage {
  id             String             @id @default(cuid())
  code           String             @unique
  name           String
  position       Int
  color          String
  isActive       Boolean            @default(true)
  isTerminal     Boolean            @default(false)
  requiresReason Boolean            @default(false)
  leads          Lead[]             @relation("LeadCurrentStage")
  spamLeads      Lead[]             @relation("LeadPreSpamStage")
  transitionsOut LeadStageHistory[] @relation("LeadPreviousStage")
  transitionsIn  LeadStageHistory[] @relation("LeadNewStage")

  @@index([isActive, position])
}

model CrmTeam {
  id          String              @id @default(cuid())
  name        String
  description String?
  createdById String?
  updatedById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdBy   User?               @relation("CrmTeamCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?               @relation("CrmTeamUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  memberships CrmTeamMembership[]

  @@index([createdById])
  @@index([updatedById])
}

model CrmTeamMembership {
  id          String                @id @default(cuid())
  teamId      String
  userId      String
  role        CrmTeamMembershipRole @default(MEMBER)
  startsAt    DateTime              @default(now())
  endsAt      DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  team        CrmTeam               @relation(fields: [teamId], references: [id], onDelete: Restrict)
  user        User                  @relation("CrmTeamMember", fields: [userId], references: [id], onDelete: Restrict)
  createdBy   User?                 @relation("CrmTeamMembershipCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?                 @relation("CrmTeamMembershipUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([teamId, startsAt, endsAt])
  @@index([userId, role, startsAt, endsAt])
  @@index([createdById])
  @@index([updatedById])
}

model Lead {
  id                   String                    @id @default(cuid())
  name                 String?
  email                String
  phone                String?
  whatsapp             String?
  country              String?
  company              String?
  interestedProductId  String?
  message              String
  sourcePage           String?
  material             String?
  thickness            String?
  workingLength        String?
  quantity             String?
  voltage              String?
  budget               String?
  status               LeadStatus                @default(NEW)
  duplicateOfId        String?
  nextFollowUpAt       DateTime?
  inquiryNumber        String?                   @unique
  recordOrigin         CrmRecordOrigin?
  sourceChannel        CrmSourceChannel?
  companyId            String?
  contactId            String?
  stageId              String?
  preSpamStageId       String?
  customerLevel        CustomerLevel?
  intentScore          Int?
  estimatedDealAmount  Decimal?                  @db.Decimal(19, 4)
  estimatedCurrency    String?
  estimatedCloseDate   DateTime?
  lastFollowUpAt       DateTime?
  lastResultCode       String?
  lostReasonCode       String?
  lostReasonNote       String?
  wonOrderNumber       String?
  wonAmount            Decimal?                  @db.Decimal(19, 4)
  wonCurrency          String?
  attributionSnapshot  Json?
  createdById          String?
  updatedById          String?
  version              Int                       @default(1)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  interestedProduct    Product?                  @relation(fields: [interestedProductId], references: [id], onDelete: SetNull)
  duplicateOf          Lead?                     @relation("LeadDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates           Lead[]                    @relation("LeadDuplicates")
  activities           LeadActivity[]
  assignments          LeadAssignment[]
  notificationAttempts LeadNotificationAttempt[]
  analyticsVisitors    AnalyticsVisitor[]
  chatConversations    ChatConversation[]
  crmCompany           Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact              Contact?                  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  stage                CrmStage?                 @relation("LeadCurrentStage", fields: [stageId], references: [id], onDelete: SetNull)
  preSpamStage         CrmStage?                 @relation("LeadPreSpamStage", fields: [preSpamStageId], references: [id], onDelete: SetNull)
  createdBy            User?                     @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            User?                     @relation("LeadUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  stageHistory         LeadStageHistory[]

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@index([interestedProductId, createdAt])
  @@index([companyId, createdAt])
  @@index([contactId, createdAt])
  @@index([stageId, createdAt])
  @@index([preSpamStageId])
  @@index([createdById])
  @@index([updatedById])
}

model LeadStageHistory {
  id              String                   @id @default(cuid())
  leadId          String
  previousStageId String?
  newStageId      String
  previousStatus  LeadStatus?
  newStatus       LeadStatus
  actorId         String?
  reasonCode      String?
  reasonNote      String?
  source          CrmStageTransitionSource
  createdAt       DateTime                 @default(now())
  lead            Lead                     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  previousStage   CrmStage?                @relation("LeadPreviousStage", fields: [previousStageId], references: [id], onDelete: Restrict)
  newStage        CrmStage                 @relation("LeadNewStage", fields: [newStageId], references: [id], onDelete: Restrict)
  actor           User?                    @relation("LeadStageHistoryActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@index([previousStageId])
  @@index([newStageId])
  @@index([actorId])
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  actorId   String?
  type      LeadActivityType
  content   String
  metadata  Json?
  createdAt DateTime         @default(now())
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor     User?            @relation("LeadActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

model LeadAssignment {
  id           String    @id @default(cuid())
  leadId       String
  assigneeId   String
  assignedById String
  assignedAt   DateTime  @default(now())
  endedAt      DateTime?
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee     User      @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedBy   User      @relation("LeadAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([leadId, endedAt])
  @@index([assigneeId, endedAt])
}

model LeadNotificationAttempt {
  id          String             @id @default(cuid())
  leadId      String
  status      NotificationStatus @default(PENDING)
  errorCode   String?
  attemptedAt DateTime           @default(now())
  lead        Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, attemptedAt])
}

model SeoRecord {
  id                   String            @id @default(cuid())
  pathname             String            @unique
  productId            String?
  title                String
  description          String
  canonicalUrl         String?
  openGraphTitle       String?
  openGraphDescription String?
  openGraphMediaId     String?
  robotsIndex          Boolean           @default(true)
  targetKeyword        String?
  status               PublicationStatus @default(DRAFT)
  version              Int               @default(1)
  publishedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  product              Product?          @relation(fields: [productId], references: [id], onDelete: Cascade)
  openGraphMedia       MediaAsset?       @relation("SeoOgMedia", fields: [openGraphMediaId], references: [id], onDelete: SetNull)

  @@index([status, robotsIndex])
  @@index([productId])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SitePage {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  pageType         String            @default("CUSTOM")
  status           PublicationStatus @default(DRAFT)
  draftContent     Json
  publishedContent Json?
  version          Int               @default(1)
  publishedVersion Int?
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  versions         PageVersion[]

  @@index([status, updatedAt])
  @@index([pageType, updatedAt])
}

model PageVersion {
  id          String    @id @default(cuid())
  pageId      String
  version     Int
  snapshot    Json
  action      String
  createdById String
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  page        SitePage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("PageVersionAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([pageId, version])
  @@index([pageId, createdAt])
  @@index([createdById, createdAt])
}

model AnalyticsVisitor {
  id                String               @id @default(cuid())
  anonymousId       String
  environment       AnalyticsEnvironment
  firstSeenAt       DateTime
  lastSeenAt        DateTime
  lastActiveAt      DateTime?
  firstSource       Json?
  lastSource        Json?
  countryCode       String?
  region            String?
  city              String?
  deviceType        String?
  browser           String?
  operatingSystem   String?
  isBot             Boolean              @default(false)
  linkedLeadId      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  linkedLead        Lead?                @relation(fields: [linkedLeadId], references: [id], onDelete: SetNull)
  sessions          AnalyticsSession[]
  pageViews         AnalyticsPageView[]
  events            AnalyticsEvent[]
  siteSearches      SiteSearchEvent[]
  chatConversations ChatConversation[]

  @@unique([environment, anonymousId])
  @@index([environment, lastSeenAt, id])
  @@index([linkedLeadId, lastSeenAt])
}

model AnalyticsSession {
  id                String               @id @default(cuid())
  visitorId         String
  sessionKey        String
  environment       AnalyticsEnvironment
  startedAt         DateTime
  lastSeenAt        DateTime
  lastActiveAt      DateTime?
  endedAt           DateTime?
  landingPath       String
  exitPath          String?
  referrer          String?
  source            String?
  medium            String?
  campaign          String?
  term              String?
  content           String?
  countryCode       String?
  region            String?
  city              String?
  deviceType        String?
  browser           String?
  operatingSystem   String?
  ipHash            String?
  isBot             Boolean              @default(false)
  pageViewCount     Int                  @default(0)
  eventCount        Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  visitor           AnalyticsVisitor     @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  pageViews         AnalyticsPageView[]
  events            AnalyticsEvent[]
  siteSearches      SiteSearchEvent[]
  chatConversations ChatConversation[]

  @@unique([environment, sessionKey])
  @@index([visitorId, startedAt])
  @@index([environment, lastSeenAt, id])
}

model ChatConversation {
  id                 String                 @id @default(cuid())
  visitorId          String
  sessionId          String?
  leadId             String?
  environment        AnalyticsEnvironment
  status             ChatConversationStatus @default(OPEN)
  contactName        String?
  contactEmail       String?
  contactWhatsapp    String?
  lastMessageAt      DateTime?
  visitorUnreadCount Int                    @default(0)
  agentUnreadCount   Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  visitor            AnalyticsVisitor       @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  session            AnalyticsSession?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  lead               Lead?                  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages           ChatMessage[]
  assignments        ChatAssignment[]

  @@index([environment, status, lastMessageAt, id])
  @@index([visitorId, updatedAt])
  @@index([leadId, updatedAt])
}

model ChatMessage {
  id              String           @id @default(cuid())
  conversationId  String
  senderType      ChatSenderType
  senderUserId    String?
  type            ChatMessageType  @default(TEXT)
  clientMessageId String
  body            String
  metadata        Json?
  sentAt          DateTime         @default(now())
  deliveredAt     DateTime?
  readAt          DateTime?
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser      User?            @relation("ChatMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, sentAt, id])
  @@index([senderUserId, sentAt])
}

model ChatAssignment {
  id             String           @id @default(cuid())
  conversationId String
  assigneeId     String
  assignedById   String
  assignedAt     DateTime         @default(now())
  endedAt        DateTime?
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignee       User             @relation("ChatAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedBy     User             @relation("ChatAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([conversationId, endedAt])
  @@index([assigneeId, endedAt])
  @@index([assignedById, assignedAt])
}

model AnalyticsPageView {
  id              String               @id @default(cuid())
  visitorId       String
  sessionId       String
  productId       String?
  environment     AnalyticsEnvironment
  pageViewKey     String
  path            String
  title           String?
  referrer        String?
  startedAt       DateTime
  lastHeartbeatAt DateTime?
  exitedAt        DateTime?
  activeSeconds   Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  visitor         AnalyticsVisitor     @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  session         AnalyticsSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product         Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  events          AnalyticsEvent[]
  siteSearches    SiteSearchEvent[]

  @@unique([environment, pageViewKey])
  @@index([sessionId, startedAt])
  @@index([visitorId, startedAt])
  @@index([productId, startedAt])
  @@index([environment, startedAt])
}

model AnalyticsEvent {
  id          String               @id @default(cuid())
  visitorId   String
  sessionId   String
  pageViewId  String?
  productId   String?
  environment AnalyticsEnvironment
  eventKey    String
  type        AnalyticsEventType
  path        String?
  properties  Json?
  occurredAt  DateTime
  createdAt   DateTime             @default(now())
  visitor     AnalyticsVisitor     @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  session     AnalyticsSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  pageView    AnalyticsPageView?   @relation(fields: [pageViewId], references: [id], onDelete: SetNull)
  product     Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([environment, eventKey])
  @@index([sessionId, occurredAt])
  @@index([visitorId, occurredAt])
  @@index([type, occurredAt])
  @@index([productId, occurredAt])
}

model SiteSearchEvent {
  id          String               @id @default(cuid())
  visitorId   String
  sessionId   String
  pageViewId  String?
  environment AnalyticsEnvironment
  eventKey    String
  query       String
  resultCount Int?
  path        String?
  occurredAt  DateTime
  createdAt   DateTime             @default(now())
  visitor     AnalyticsVisitor     @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  session     AnalyticsSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  pageView    AnalyticsPageView?   @relation(fields: [pageViewId], references: [id], onDelete: SetNull)

  @@unique([environment, eventKey])
  @@index([sessionId, occurredAt])
  @@index([visitorId, occurredAt])
  @@index([query, occurredAt])
}

model AnalyticsDailySummary {
  id             String               @id @default(cuid())
  environment    AnalyticsEnvironment
  date           DateTime
  dimension      String
  dimensionValue String
  metrics        Json
  version        Int                  @default(1)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([environment, date, dimension, dimensionValue])
  @@index([environment, date])
}
