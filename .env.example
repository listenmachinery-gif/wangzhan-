INQUIRY_TO_EMAIL=info@zyroncnc.com
SMTP_HOST=smtp.larksuite.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@zyroncnc.com
SMTP_PASS=your-mailbox-app-password
SMTP_FROM=info@zyroncnc.com

# PostgreSQL. Use separate development, test, and production databases.
DATABASE_URL=postgresql://postgres:password@localhost:5432/zyron_cms_dev
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/zyron_cms_test

# Authentication secrets must be generated per environment.
SESSION_SECRET=replace-with-at-least-32-random-bytes

# One-time explicit administrator bootstrap inputs. Never commit real values.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=ZYRON Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# S3-compatible object storage (Cloudflare R2 or equivalent).
OBJECT_STORAGE_DRIVER=s3
OBJECT_STORAGE_ENDPOINT=https://account-id.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=zyron-cms
OBJECT_STORAGE_ACCESS_KEY_ID=replace-me
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me
OBJECT_STORAGE_PUBLIC_BASE_URL=https://media.example.com

# Local test storage only; do not use this directory as production storage.
OBJECT_STORAGE_LOCAL_DIR=.data/uploads

# Explicit one-time production gates. Keep false/absent until separately approved.
ALLOW_PRODUCTION_BOOTSTRAP=false
ZYRON_PRODUCTION_CHANGE_AUTHORIZED=false
# One deployment only. Remove from Production immediately after the approved migration build.
ALLOW_PRODUCTION_MIGRATIONS=false

# Local migration compatibility only; production CMS should use database records.
ZYRON_ENABLE_LEGACY_PRODUCT_FALLBACK=false

# Google Analytics 4 public tracking identifier. This value is visible in browser JavaScript.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Read-only Google reporting integration. Keep the service-account values server-side only.
GOOGLE_ANALYTICS_PROPERTY_ID=123456789
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:zyroncnc.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=zyron-reports@example-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-vercel-secret\n-----END PRIVATE KEY-----"

# First-party analytics derives its isolated data environment from NODE_ENV/VERCEL_ENV:
# DEVELOPMENT (local), TEST (automated tests), PREVIEW (Vercel Preview), PRODUCTION (official site).
# It reuses SESSION_SECRET for signed anonymous IDs and month-rotated network hashes.

# Realtime chat is opt-in per environment. Use a dedicated Upstash database/namespace for
# Preview and Production, a TLS URL, and a different 32+ byte token secret in each environment.
REALTIME_ENABLED=false
UPSTASH_REDIS_URL=rediss://default:replace-with-vercel-secret@example.upstash.io:6379
REALTIME_TOKEN_SECRET=replace-with-at-least-32-random-bytes

# Authenticates Vercel Cron/internal maintenance routes. Use a unique 32+ byte secret per environment.
CRON_SECRET=replace-with-at-least-32-random-bytes

# Privacy defaults: raw first-party data 180 days, summaries 730 days, chats 730 days (24 months).
ANALYTICS_RAW_RETENTION_DAYS=180
ANALYTICS_SUMMARY_RETENTION_DAYS=730
CHAT_RETENTION_DAYS=730
PRIVACY_RETENTION_BATCH_SIZE=250
