{
  "name": "zhuoyao-heavy-industry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "tsx scripts/vercel-build.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude 'tests/integration/**' --exclude 'tests/e2e/**'",
    "test:integration": "dotenv run -f .env.test -- vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "dotenv run -f .env.test -- playwright test",
    "audit:deployment-size": "node scripts/audit-deployment-size.mjs",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:test": "dotenv run -f .env.test -- prisma migrate deploy",
    "db:seed:rbac": "tsx prisma/seed-rbac.ts",
    "db:seed:crm": "tsx prisma/seed-crm.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "homepage:publish": "node --conditions=react-server --import tsx scripts/publish-homepage-redesign.ts",
    "import:catalogue": "tsx scripts/import-legacy-catalogue.ts",
    "verify:catalogue": "tsx scripts/verify-catalogue-migration.ts",
    "verify:nc-press-brake": "node scripts/verify-nc-hydraulic-press-brake-page.mjs",
    "verify:torsion-bar-press-brake": "node scripts/verify-torsion-bar-cnc-press-brake-page.mjs",
    "verify:exchange-table-laser": "node scripts/verify-exchange-table-fiber-laser-cutting-machine-page.mjs",
    "verify:single-table-laser": "node scripts/verify-single-table-fiber-laser-cutting-machine-page.mjs",
    "verify:sheet-and-tube-laser": "node scripts/verify-sheet-and-tube-fiber-laser-cutting-machine-page.mjs",
    "verify:fiber-tube-laser": "node scripts/verify-fiber-tube-laser-cutting-machine-page.mjs",
    "verify:electric-two-roll-rolling": "node scripts/verify-electric-two-roll-plate-rolling-machine-page.mjs",
    "verify:semi-automatic-three-roll-rolling": "node scripts/verify-semi-automatic-three-roll-plate-rolling-machine-page.mjs",
    "verify:fully-automatic-three-roll-rolling": "node scripts/verify-fully-automatic-three-roll-plate-rolling-machine-page.mjs",
    "verify:hydraulic-four-roll-rolling": "node scripts/verify-hydraulic-four-roll-plate-rolling-machine-page.mjs",
    "verify:about-zyron": "node scripts/verify-about-zyron-page.mjs",
    "verify:foot-shear-seo": "node scripts/verify-foot-shear-page.mjs",
    "verify:foot-shear-media": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/verify-foot-shear-media.mjs",
    "verify:reel-shear-seo": "node scripts/verify-slitting-and-beading-machine-parameters.mjs",
    "verify:small-electric-shear-seo": "node scripts/verify-small-electric-shear-page.mjs",
    "verify:small-electric-shear-media": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/verify-small-electric-shear-media.mjs",
    "verify:small-electric-shear-selector": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/verify-small-electric-shear-selector.mjs",
    "verify:energy-saving-shear-seo": "node scripts/verify-energy-saving-electric-shear-page.mjs",
    "verify:hydraulic-swing-beam-seo": "node scripts/verify-hydraulic-swing-beam-shear-page.mjs",
    "db:backfill:crm": "tsx scripts/backfill-crm-foundation.ts"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@next/third-parties": "15.5.19",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/functions": "^3.11.3",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "google-auth-library": "10.9.1",
    "i18n-iso-countries": "^7.14.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.19",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-simple-maps": "^5.0.5",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "world-atlas": "^2.0.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^20.17.9",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.1.0",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.19",
    "jsdom": "^31.0.1",
    "postcss": "8.5.33",
    "prisma": "^7.10.1",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "brace-expansion@1.1.16": "1.1.21",
    "postcss": "$postcss"
  }
}
